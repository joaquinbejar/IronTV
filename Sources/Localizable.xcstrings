    "If this started after reinstalling or updating the app, removing the stored account and adding it again resolves it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si esto empezó tras reinstalar o actualizar la app, eliminar la cuenta guardada y añadirla de nuevo lo resuelve."
          }
        }
      }
    },
