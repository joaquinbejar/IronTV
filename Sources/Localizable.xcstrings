  "strings": {
    "%lld h": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "API request timeout": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo de espera de la API"
          }
        }
      }
    },
    "Account": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta"
          }
        }
      }
    },
    "Account valid (no expiry reported)": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta válida (sin caducidad informada)"
          }
        }
      }
    },
    "Account valid until %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta válida hasta el %@"
          }
        }
      }
    },
    "Account valid, but the panel reports it expired on %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta válida, pero el panel indica que caducó el %@"
          }
        }
      }
    },
    "Add to Favorites": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir a favoritos"
          }
        }
      }
    },
    "After the fast attempts, IronTV keeps retrying indefinitely at a slower, capped cadence — a live stream never gives up. Reconnect pacing applies to both engines; buffering and frozen-video detection are Apple-engine health checks.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras los intentos rápidos, IronTV sigue reintentando indefinidamente a un ritmo más lento y limitado; un directo nunca se rinde. El ritmo de reconexión aplica a ambos motores; la detección de búfer y de vídeo congelado son comprobaciones del motor de Apple."
          }
        }
      }
    },
    "All Channels": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los canales"
          }
        }
      }
    },
    "Apple": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "Apple (HLS)": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "Apple engine": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Motor Apple"
          }
        }
      }
    },
    "Auto-reconnect": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconexión automática"
          }
        }
      }
    },
    "Automatic": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático"
          }
        }
      }
    },
    "Automatic starts with the Apple player and silently switches a channel to the VLC engine (raw MPEG-TS, like most IPTV apps) when it keeps stalling or uses unsupported codecs. The player shows which engine is active in its toolbar.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático empieza con el reproductor de Apple y cambia un canal al motor VLC en silencio (MPEG-TS en bruto, como la mayoría de apps IPTV) cuando se corta continuamente o usa códecs no compatibles. El reproductor muestra el motor activo en su barra de herramientas."
          }
        }
      }
    },
    "Awaiting HTTP confirmation": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando confirmación HTTP"
          }
        }
      }
    },
