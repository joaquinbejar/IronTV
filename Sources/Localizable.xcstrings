    "Connected by reading the playlist. Your provider has no panel to ask, so there is no expiry date or connection limit to show.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado leyendo la lista de reproducción. Tu proveedor no tiene panel al que preguntar, así que no hay fecha de caducidad ni límite de conexiones que mostrar."
          }
        }
      }
    },
